{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bahi-Khata",
  "mainBinaryName": "BahiKhata",
  "version": "0.1.0",
  "identifier": "com.harsh0595.bahikhata",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bahi-Khata",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 660,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "harsh0595",
    "shortDescription": "Offline bank statement analyser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
